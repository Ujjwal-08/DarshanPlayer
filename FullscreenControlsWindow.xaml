<Window x:Class="DarshanPlayer.FullscreenControlsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Fullscreen Controls"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True">
    <Border x:Name="OverlayChrome" Background="{StaticResource TrayBgBrush}" CornerRadius="16"
            Padding="20,15" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            MouseEnter="RootSurface_MouseEnter"
            MouseMove="RootSurface_MouseMove">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" Opacity="0.5" ShadowDepth="10"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Slider Grid.Row="0" Style="{StaticResource SeekSlider}" IsMoveToPointEnabled="True"
                    Maximum="1" Value="{Binding Position, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Margin="0,0,0,15"
                    PreviewMouseLeftButtonDown="SeekSlider_PreviewMouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="SeekSlider_PreviewMouseLeftButtonUp"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentTimeStr}" VerticalAlignment="Center" FontSize="14" Margin="0,0,15,0"/>
                    <TextBlock Text="/" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <TextBlock Text="{Binding TotalTimeStr}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconBtn}" Command="{Binding PrevTrackCommand}" Margin="0,0,12,0">
                        <iconPacks:PackIconMaterial Kind="SkipPrevious" Width="24" Height="24"/>
                    </Button>
                    <Button Style="{StaticResource IconBtn}" Command="{Binding SkipBackCommand}" ToolTip="Back 10 seconds" Margin="0,0,12,0">
                        <iconPacks:PackIconMaterial Kind="Rewind" Width="24" Height="24"/>
                    </Button>
                    <Button Style="{StaticResource PlayBtn}" Command="{Binding PlayPauseCommand}" Width="56" Height="56" Margin="0,0,12,0">
                        <iconPacks:PackIconMaterial Kind="{Binding PlayPauseIcon}" Width="32" Height="32"/>
                    </Button>
                    <Button Style="{StaticResource IconBtn}" Command="{Binding SkipForwardCommand}" ToolTip="Forward 10 seconds" Margin="0,0,12,0">
                        <iconPacks:PackIconMaterial Kind="FastForward" Width="24" Height="24"/>
                    </Button>
                    <Button Style="{StaticResource IconBtn}" Command="{Binding NextTrackCommand}">
                        <iconPacks:PackIconMaterial Kind="SkipNext" Width="24" Height="24"/>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconBtn}" Command="{Binding TogglePlaylistCommand}" ToolTip="Playlist" Margin="0,0,12,0">
                        <iconPacks:PackIconMaterial Kind="PlaylistPlay" Width="24" Height="24"/>
                    </Button>
                    <Button Style="{StaticResource IconBtn}" Command="{Binding ToggleFullscreenCommand}" ToolTip="Exit Fullscreen">
                        <iconPacks:PackIconMaterial Kind="FullscreenExit" Width="24" Height="24"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
