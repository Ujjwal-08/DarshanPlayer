<Window x:Class="DarshanPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:vm="clr-namespace:DarshanPlayer.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:local="clr-namespace:DarshanPlayer"
        Title="Darshan Player"
        Icon="icon.ico"
        Width="1100" Height="700"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#111111"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        KeyDown="Window_KeyDown"
        PreviewKeyDown="Root_PreviewKeyDown"
        StateChanged="Window_StateChanged"
        PreviewMouseMove="Root_MouseMove"
        MouseMove="Root_MouseMove"
        MouseEnter="Root_MouseEnter">
        
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            ResizeBorderThickness="4"/>
    </shell:WindowChrome.WindowChrome>

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressValue="{Binding Position}"
                         ProgressState="{Binding TaskbarProgressState}">
            <TaskbarItemInfo.ThumbButtonInfos>
                <ThumbButtonInfoCollection>
                    <ThumbButtonInfo Description="Previous" DismissWhenClicked="False"
                                     Command="{Binding PrevTrackCommand}"/>
                    <ThumbButtonInfo Description="Play / Pause" DismissWhenClicked="False"
                                     Command="{Binding PlayPauseCommand}"/>
                    <ThumbButtonInfo Description="Next" DismissWhenClicked="False"
                                     Command="{Binding NextTrackCommand}"/>
                </ThumbButtonInfoCollection>
            </TaskbarItemInfo.ThumbButtonInfos>
        </TaskbarItemInfo>
    </Window.TaskbarItemInfo>

    <Window.Resources>
        <ResourceDictionary>
            <ContextMenu x:Key="SleepMenu">
                <MenuItem Header="{DynamicResource str_5min}"  Click="SleepTimer_5"/>
                <MenuItem Header="{DynamicResource str_10min}" Click="SleepTimer_10"/>
                <MenuItem Header="{DynamicResource str_15min}" Click="SleepTimer_15"/>
                <MenuItem Header="{DynamicResource str_30min}" Click="SleepTimer_30"/>
                <MenuItem Header="{DynamicResource str_60min}" Click="SleepTimer_60"/>
                <Separator/>
                <MenuItem Header="{DynamicResource str_Cancel}" Click="SleepTimer_Cancel"/>
            </ContextMenu>

            <ContextMenu x:Key="SettingsMenu">
                <MenuItem Header="{DynamicResource str_PlaybackRate}">
                    <MenuItem Header="0.25x" IsCheckable="True" IsChecked="{Binding IsRate025, Mode=TwoWay}" Command="{Binding RateCommand}" CommandParameter="0.25"/>
                    <MenuItem Header="0.5x"  IsCheckable="True" IsChecked="{Binding IsRate05,  Mode=TwoWay}" Command="{Binding RateCommand}" CommandParameter="0.5"/>
                    <MenuItem Header="0.75x" IsCheckable="True" IsChecked="{Binding IsRate075, Mode=TwoWay}" Command="{Binding RateCommand}" CommandParameter="0.75"/>
                    <MenuItem Header="1.0x (Normal)" IsCheckable="True" IsChecked="{Binding IsRate10,  Mode=TwoWay}" Command="{Binding RateCommand}" CommandParameter="1.0"/>
                    <MenuItem Header="1.25x" IsCheckable="True" IsChecked="{Binding IsRate125, Mode=TwoWay}" Command="{Binding RateCommand}" CommandParameter="1.25"/>
                    <MenuItem Header="1.5x"  IsCheckable="True" IsChecked="{Binding IsRate15,  Mode=TwoWay}" Command="{Binding RateCommand}" CommandParameter="1.5"/>
                    <MenuItem Header="1.75x" IsCheckable="True" IsChecked="{Binding IsRate175, Mode=TwoWay}" Command="{Binding RateCommand}" CommandParameter="1.75"/>
                    <MenuItem Header="2.0x"  IsCheckable="True" IsChecked="{Binding IsRate20,  Mode=TwoWay}" Command="{Binding RateCommand}" CommandParameter="2.0"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{DynamicResource str_AudioTrack}" ItemsSource="{Binding AudioTracks}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding Name}"/>
                            <Setter Property="IsCheckable" Value="True"/>
                            <Setter Property="IsChecked" Value="{Binding IsActive, Mode=OneWay}"/>
                            <Setter Property="Command" Value="{Binding DataContext.SelectAudioTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <Setter Property="CommandParameter" Value="{Binding}"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <MenuItem Header="{DynamicResource str_SubtitleTrack}" ItemsSource="{Binding SubtitleTracks}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding Name}"/>
                            <Setter Property="IsCheckable" Value="True"/>
                            <Setter Property="IsChecked" Value="{Binding IsActive, Mode=OneWay}"/>
                            <Setter Property="Command" Value="{Binding DataContext.SelectSubtitleTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            <Setter Property="CommandParameter" Value="{Binding}"/>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{DynamicResource str_VideoAdjustments}" Command="{Binding ToggleVideoAdjustCommand}"/>
                <MenuItem Header="{DynamicResource str_SubtitleSettings}" Command="{Binding ToggleSubtitleStyleCommand}"/>
                <Separator/>
                <MenuItem Header="{DynamicResource str_AlwaysOnTop}" IsCheckable="True" IsChecked="{Binding AlwaysOnTop}"/>
                <MenuItem Header="{DynamicResource str_HardwareAcceleration}" IsCheckable="True" IsChecked="{Binding EnableHardwareAcceleration}"/>
                <MenuItem Header="{DynamicResource str_ViewInfo}" Command="{Binding ToggleMetadataCommand}"/>
                <Separator/>
                <MenuItem Header="{DynamicResource str_Language}">
                    <MenuItem Header="English" Command="{Binding ChangeLanguageCommand}" CommandParameter="en"/>
                    <MenuItem Header="Hindi" Command="{Binding ChangeLanguageCommand}" CommandParameter="hi"/>
                    <MenuItem Header="Tamil" Command="{Binding ChangeLanguageCommand}" CommandParameter="ta"/>
                    <MenuItem Header="Telugu" Command="{Binding ChangeLanguageCommand}" CommandParameter="te"/>
                    <MenuItem Header="Kannada" Command="{Binding ChangeLanguageCommand}" CommandParameter="kn"/>
                    <MenuItem Header="Marathi" Command="{Binding ChangeLanguageCommand}" CommandParameter="mr"/>
                    <MenuItem Header="Bengali" Command="{Binding ChangeLanguageCommand}" CommandParameter="bn"/>
                    <MenuItem Header="Punjabi" Command="{Binding ChangeLanguageCommand}" CommandParameter="pa"/>
                    <MenuItem Header="Gujarati" Command="{Binding ChangeLanguageCommand}" CommandParameter="gu"/>
                    <MenuItem Header="Malayalam" Command="{Binding ChangeLanguageCommand}" CommandParameter="ml"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="More Settings..." Click="OpenSettingsDialog_Click"/>
            </ContextMenu>

            <Style x:Key="TitleBarBtn" TargetType="Button" BasedOn="{StaticResource IconBtn}">
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource BgDeepBrush}">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleRow" Height="Auto"/> <!-- Title Bar -->
            <RowDefinition Height="*"/>    <!-- Video View Area -->
            <RowDefinition x:Name="ControlsRow" Height="Auto"/> <!-- Control Bar -->
        </Grid.RowDefinitions>

        <!-- TITLE BAR -->
        <Border x:Name="TitleBar" Grid.Row="0" Background="{StaticResource BgPanelBrush}"
                MouseLeftButtonDown="TitleBar_MouseDown">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPipMode}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                    <TextBlock Text="DP" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource AccentLightBrush}"/>
                    <TextBlock Text="Darshan Player" Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TextBtn}" Click="MenuOpen_Click">
                        <TextBlock Text="{DynamicResource str_Open}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    </Button>
                    <Button Style="{StaticResource TextBtn}" Click="MenuOpenFolder_Click">
                        <TextBlock Text="{DynamicResource str_OpenFolder}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    </Button>
                    <Button x:Name="RecentBtn" Style="{StaticResource TitleBarBtn}"
                        Click="MenuRecent_Click" ToolTip="{DynamicResource str_RecentFiles}" Margin="2,0">
                        <iconPacks:PackIconMaterial Kind="History" Width="14" Height="14"/>
                    </Button>
                    <Button x:Name="RecentFoldersBtn" Style="{StaticResource TitleBarBtn}"
                        Click="MenuRecentFolders_Click" ToolTip="Recent Folders" Margin="2,0">
                        <iconPacks:PackIconMaterial Kind="FolderOpen" Width="14" Height="14"/>
                    </Button>
                    <!-- Sleep Timer Button with countdown badge -->
                    <Grid Margin="2,0">
                        <Button x:Name="SleepBtn" Style="{StaticResource TitleBarBtn}"
                            Click="MenuSleepTimer_Click" ToolTip="{Binding SleepTimerLabel, FallbackValue='Sleep Timer'}">
                            <iconPacks:PackIconMaterial Kind="WeatherNight" Width="14" Height="14"/>
                        </Button>
                        <!-- Red badge shown when sleep timer is active -->
                        <Border x:Name="SleepBadge" Width="18" Height="18" CornerRadius="9"
                                Background="{StaticResource DangerBrush}"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0"
                                Visibility="{Binding IsSleepTimerActive, Converter={StaticResource BoolToVisConverter}}"
                                IsHitTestVisible="False">
                            <TextBlock Text="z" FontSize="9" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="Segoe UI"/>
                        </Border>
                    </Grid>
                    <Button x:Name="SettingsBtn" Style="{StaticResource TitleBarBtn}"
                        Click="MenuSettings_Click" ToolTip="{DynamicResource str_Settings}" Margin="2,0">
                        <iconPacks:PackIconMaterial Kind="Tune" Width="14" Height="14"/>
                    </Button>
                    <ComboBox Style="{StaticResource DarkCombo}" Width="120" Margin="8,0"
                               ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                               DisplayMemberPath="DisplayName" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource IconBtn}" Click="BtnSupportPatreon_Click" ToolTip="Support on Patreon" shell:WindowChrome.IsHitTestVisibleInChrome="True" Background="Transparent">
                        <iconPacks:PackIconMaterial Kind="Heart" Width="14" Height="14" Foreground="#FF6B6B"/>
                    </Button>
                    <Button Style="{StaticResource IconBtn}" Click="BtnSupportPaypal_Click" ToolTip="Support via PayPal" shell:WindowChrome.IsHitTestVisibleInChrome="True" Background="Transparent">
                        <iconPacks:PackIconMaterial Kind="CurrencyUsd" Width="14" Height="14"/>
                    </Button>
                    <Separator Width="1" Height="20" Margin="4,0" Background="#33FFFFFF"/>
                    
                    <Button Style="{StaticResource IconBtn}" Click="BtnMinimize_Click">
                        <iconPacks:PackIconMaterial Kind="WindowMinimize" Width="14" Height="14"/>
                    </Button>
                    <Button Style="{StaticResource IconBtn}" Click="BtnPip_Click" ToolTip="Picture in Picture">
                        <iconPacks:PackIconMaterial Kind="PictureInPictureBottomRight" Width="14" Height="14"/>
                    </Button>
                    <Button Style="{StaticResource IconBtn}" Click="BtnMaximize_Click">
                        <iconPacks:PackIconMaterial Kind="WindowMaximize" Width="14" Height="14"/>
                    </Button>
                    <Button Style="{StaticResource IconBtn}" Click="BtnClose_Click" Foreground="{StaticResource DangerBrush}">
                        <iconPacks:PackIconMaterial Kind="WindowClose" Width="14" Height="14"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- VIDEO + PLAYLIST AREA -->
        <Grid Grid.Row="1" x:Name="VideoPlaylistGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="260" MinWidth="220" MaxWidth="500"/>
            </Grid.ColumnDefinitions>

            <!-- Splitter — only shown when playlist is open -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"
                          Visibility="{Binding IsPlaylistVisible, Converter={StaticResource BoolToVisConverter}}"/>

            <!-- Video Area -->
            <Grid x:Name="VideoArea" Grid.Column="0" Background="Black"
                  MouseEnter="VideoArea_MouseEnter" MouseMove="VideoArea_MouseMove"
                  MouseLeftButtonDown="VideoArea_MouseDown">
                <vlc:VideoView x:Name="VideoPlayer" Background="Black" IsHitTestVisible="False"
                               Visibility="{Binding IsMediaLoaded, Converter={StaticResource BoolToVisConverter}}"/>

                <!-- Overlay shown during subtitle-settings reload to hide VideoView swap -->
                <Border x:Name="SubtitleApplyOverlay" Visibility="Collapsed"
                        Background="#F00D0D0D" Panel.ZIndex="5" IsHitTestVisible="False">
                    <TextBlock Text="Applying subtitle settings…" Foreground="White"
                               FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <Border Background="#080808"
                        Visibility="{Binding IsMediaLoaded, Converter={StaticResource InverseBoolToVisConverter}}">
                    <Grid>
                        <Border Width="420" MaxWidth="420" Padding="24" CornerRadius="16"
                                Background="#CC111111" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="Darshan Player" FontSize="26" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Open a video or audio file to start playback."
                                           Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="14"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                                    <Button Style="{StaticResource TextBtn}" Command="{Binding OpenFileCommand}" Margin="0,0,10,0" Padding="14,8">
                                        <TextBlock Text="{DynamicResource str_Open}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </Button>
                                    <Button Style="{StaticResource TextBtn}" Command="{Binding OpenFolderCommand}" Padding="14,8">
                                        <TextBlock Text="{DynamicResource str_OpenFolder}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>



                <Border x:Name="DropHintOverlay" Visibility="Collapsed" Background="#AA000000" IsHitTestVisible="False">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📂" FontSize="48" HorizontalAlignment="Center"/>
                        <TextBlock Text="Drop media files here" FontSize="18" Foreground="White" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Overlay Layer -->
                <Grid x:Name="OverlayLayer" IsHitTestVisible="True">
                    <!-- Metadata Overlay (Now a Popup to solve Airspace issue) -->
                    <Popup x:Name="MetadataPopup" IsOpen="{Binding IsMetadataVisible}" Placement="Center" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Background="{StaticResource BgCardBrush}" CornerRadius="12" Padding="20" BorderBrush="{StaticResource AccentGlowBrush}" BorderThickness="1" MaxWidth="500">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="30" Opacity="0.6" ShadowDepth="0"/>
                            </Border.Effect>
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,10">
                                    <TextBlock Text="Media Information" FontWeight="Bold" FontSize="16" DockPanel.Dock="Left" FontFamily="Segoe UI"/>
                                    <Button Click="BtnCloseMetadata_Click" Style="{StaticResource IconBtn}" DockPanel.Dock="Right" Width="28" Height="28">
                                        <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14"/>
                                    </Button>
                                </DockPanel>
                                <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,10"/>
                                <TextBlock Text="{Binding MediaMetadataText}" TextWrapping="Wrap" FontSize="13" LineHeight="20" FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Border>
                    </Popup>

                        <!-- Resume Prompt Overlay -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" 
                                Margin="20" Padding="16,12" Background="#DD111111" 
                                BorderBrush="{StaticResource AccentBrush}" BorderThickness="1,0,0,0" CornerRadius="4"
                                Visibility="{Binding IsResumePromptVisible, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel>
                                <TextBlock Text="{Binding ResumePromptMessage}" Foreground="White" FontSize="13"
                                           Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource TextBtn}" Command="{Binding DismissResumePromptCommand}" Margin="0,0,10,0">
                                        <TextBlock Text="Dismiss" Foreground="#88FFFFFF"/>
                                    </Button>
                                    <Button Style="{StaticResource TextBtn}" Command="{Binding ResumeSessionCommand}"
                                            Padding="14,6" Background="{StaticResource AccentBrush}">
                                        <TextBlock Text="Resume" Foreground="White" FontSize="12"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- VIDEO ADJUSTMENTS PANEL (Phase 12.1) -->
                        <Popup x:Name="VideoAdjustPopup" IsOpen="{Binding IsVideoAdjustVisible, Mode=TwoWay}"
                               Placement="Center" AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="True">
                            <Border Background="{StaticResource BgCardBrush}" CornerRadius="12" Padding="20"
                                    BorderBrush="{StaticResource AccentGlowBrush}" BorderThickness="1" Width="400">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="30" Opacity="0.6" ShadowDepth="0"/>
                                </Border.Effect>
                                <StackPanel>
                                    <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                        <TextBlock Text="{DynamicResource str_VideoAdjustments}" FontWeight="Bold" FontSize="16" DockPanel.Dock="Left"/>
                                        <Button Command="{Binding ToggleVideoAdjustCommand}" Style="{StaticResource IconBtn}" DockPanel.Dock="Right" Width="28" Height="28">
                                            <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14"/>
                                        </Button>
                                    </DockPanel>
                                    <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,12"/>

                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource str_Brightness}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                        <Slider Grid.Column="1" Style="{StaticResource VolumeSlider}" Minimum="0" Maximum="2" VerticalAlignment="Center"
                                                Value="{Binding Brightness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding BrightnessLabel}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12"/>
                                    </Grid>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource str_Contrast}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                        <Slider Grid.Column="1" Style="{StaticResource VolumeSlider}" Minimum="0" Maximum="2" VerticalAlignment="Center"
                                                Value="{Binding Contrast, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding ContrastLabel}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12"/>
                                    </Grid>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource str_Saturation}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                        <Slider Grid.Column="1" Style="{StaticResource VolumeSlider}" Minimum="0" Maximum="3" VerticalAlignment="Center"
                                                Value="{Binding Saturation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding SaturationLabel}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12"/>
                                    </Grid>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource str_Gamma}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                        <Slider Grid.Column="1" Style="{StaticResource VolumeSlider}" Minimum="0.01" Maximum="10" VerticalAlignment="Center"
                                                Value="{Binding Gamma, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding GammaLabel}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12"/>
                                    </Grid>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource str_Hue}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                        <Slider Grid.Column="1" Style="{StaticResource VolumeSlider}" Minimum="-180" Maximum="180" VerticalAlignment="Center"
                                                Value="{Binding Hue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding HueLabel}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12"/>
                                    </Grid>

                                    <Button Command="{Binding ResetVideoAdjustmentsCommand}" Style="{StaticResource TextBtn}"
                                            HorizontalAlignment="Right" Margin="0,12,0,0" Padding="14,6" Background="{StaticResource BgHoverBrush}">
                                        <TextBlock Text="{DynamicResource str_ResetAll}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <!-- SUBTITLE SETTINGS PANEL (Phase 10.3) -->
                        <Popup x:Name="SubtitleStylePopup" IsOpen="{Binding IsSubtitleStyleVisible, Mode=TwoWay}"
                               Placement="Center" AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="True">
                            <Border Background="{StaticResource BgCardBrush}" CornerRadius="12" Padding="20"
                                    BorderBrush="{StaticResource AccentGlowBrush}" BorderThickness="1" Width="400">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="30" Opacity="0.6" ShadowDepth="0"/>
                                </Border.Effect>
                                <StackPanel>
                                    <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                        <TextBlock Text="{DynamicResource str_SubtitleSettings}" FontWeight="Bold" FontSize="16" DockPanel.Dock="Left"/>
                                        <Button Command="{Binding ToggleSubtitleStyleCommand}" Style="{StaticResource IconBtn}" DockPanel.Dock="Right" Width="28" Height="28">
                                            <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14"/>
                                        </Button>
                                    </DockPanel>
                                    <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,12"/>

                                    <!-- Font size -->
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource str_FontSize}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                        <Slider Grid.Column="1" Style="{StaticResource VolumeSlider}" Minimum="0" Maximum="48" VerticalAlignment="Center"
                                                IsSnapToTickEnabled="True" TickFrequency="1"
                                                Value="{Binding SubtitleFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding SubtitleFontSizeLabel}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12"/>
                                    </Grid>

                                    <!-- Font family -->
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource str_Font}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                        <ComboBox Grid.Column="1" Style="{StaticResource DarkCombo}"
                                                  ItemsSource="{Binding SubtitleFontList}" SelectedItem="{Binding SelectedSubtitleFont, Mode=TwoWay}"/>
                                    </Grid>

                                    <!-- Text colour -->
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource str_TextColor}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding SubtitleColorOptions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Width="26" Height="26" Margin="3" Cursor="Hand" ToolTip="{Binding Name}"
                                                            Command="{Binding DataContext.SetSubtitleColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border CornerRadius="6" Background="{Binding Swatch}"
                                                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border Grid.Column="2" Width="26" Height="26" CornerRadius="6" VerticalAlignment="Center"
                                                Background="{Binding SubtitleColorPreview}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                                    </Grid>

                                    <!-- Outline thickness -->
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource str_Outline}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                        <Slider Grid.Column="1" Style="{StaticResource VolumeSlider}" Minimum="0" Maximum="10" VerticalAlignment="Center"
                                                IsSnapToTickEnabled="True" TickFrequency="1"
                                                Value="{Binding SubtitleOutlineThickness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding SubtitleOutlineThickness}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12"/>
                                    </Grid>

                                    <!-- Background opacity -->
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource str_Background}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                        <Slider Grid.Column="1" Style="{StaticResource VolumeSlider}" Minimum="0" Maximum="255" VerticalAlignment="Center"
                                                IsSnapToTickEnabled="True" TickFrequency="1"
                                                Value="{Binding SubtitleBackgroundOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding SubtitleBackgroundOpacity}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12"/>
                                    </Grid>

                                    <TextBlock Text="Style settings take effect after restarting the app or clicking Reload below."
                                               TextWrapping="Wrap" Margin="0,12,0,4"
                                               Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                    <Button Style="{StaticResource TextBtn}" Padding="10,6" Margin="0,4,0,0"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding ReloadWithSubtitleSettingsCommand}"
                                            ToolTip="Reloads current file and restores subtitle track with updated style">
                                        <TextBlock Text="↺ Reload &amp; Apply" Foreground="{StaticResource AccentLightBrush}" FontSize="12"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <!-- TOAST NOTIFICATIONS (Phase 23) — hosted in a Popup so they float above the
                             native video surface. The full-size grid has no background so clicks pass
                             through to the video; only the toast cards themselves are visible. -->
                        <Popup x:Name="ToastPopup" IsOpen="{Binding HasToasts, Mode=OneWay}" AllowsTransparency="True"
                               Placement="Center" PlacementTarget="{Binding ElementName=VideoArea}" StaysOpen="True">
                            <Grid Width="{Binding ActualWidth, ElementName=VideoArea}" Height="{Binding ActualHeight, ElementName=VideoArea}"
                                  IsHitTestVisible="False">
                                <ItemsControl ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="20" MaxWidth="360">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource BgCardBrush}" CornerRadius="8" Margin="0,6,0,0"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="16" Opacity="0.5" ShadowDepth="2"/>
                                                </Border.Effect>
                                                <Grid MinWidth="220">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="4"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border x:Name="Stripe" Grid.Column="0" CornerRadius="8,0,0,8" Background="{StaticResource AccentBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Icon}" FontSize="14" FontWeight="Bold" Margin="12,10,8,10" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" Margin="0,10,14,10" VerticalAlignment="Center" FontSize="12"/>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="Success">
                                                    <Setter TargetName="Stripe" Property="Background" Value="#3FB950"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="Warning">
                                                    <Setter TargetName="Stripe" Property="Background" Value="#F0A020"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="Error">
                                                    <Setter TargetName="Stripe" Property="Background" Value="{StaticResource DangerBrush}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Popup>
                </Grid>
            </Grid>

            <!-- PLAYLIST PANEL -->
            <Border Grid.Column="2" x:Name="PlaylistPanel"
                    Background="{StaticResource BgPanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,0"
                    Visibility="{Binding IsPlaylistVisible, Converter={StaticResource BoolToVisConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="12,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <TextBlock Text="{DynamicResource str_Playlist}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                    </Border>
                    <!-- Filter + Sort row (Phase 13.4) -->
                    <Grid Grid.Row="1" Margin="6,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding PlaylistVM.FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{StaticResource BgPanelBrush}"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderBrush="{StaticResource BorderBrush}"
                                 Padding="4,2" FontSize="11"/>
                        <Button Grid.Column="1" Style="{StaticResource TextBtn}" FontSize="11" Margin="4,0"
                                Command="{Binding PlaylistVM.ToggleSortCommand}"
                                ToolTip="Sort A→Z / Off">
                            <TextBlock Text="A↓" Foreground="{StaticResource AccentLightBrush}"/>
                        </Button>
                    </Grid>
                    <ListBox Grid.Row="2" x:Name="PlaylistBox" Style="{StaticResource PlaylistListBox}"
                             ItemsSource="{Binding PlaylistVM.FilteredItems}" SelectedItem="{Binding PlaylistVM.SelectedItem}"
                             MouseDoubleClick="Playlist_DoubleClick" Padding="6"
                             AllowDrop="True"
                             PreviewMouseMove="PlaylistBox_MouseMove"
                             Drop="PlaylistBox_Drop"/>
                    <Border Grid.Row="3" Padding="8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                        <WrapPanel HorizontalAlignment="Center">
                            <Button Style="{StaticResource TextBtn}" Click="MenuOpen_Click" FontSize="11" Margin="4,0">
                                <TextBlock Text="{DynamicResource str_Open}" Foreground="{StaticResource AccentLightBrush}"/>
                            </Button>
                            <Button Style="{StaticResource TextBtn}" Command="{Binding PlaylistVM.RemoveCommand}" FontSize="11" Margin="4,0">
                                <TextBlock Text="{DynamicResource str_Remove}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Button>
                            <Button Style="{StaticResource TextBtn}" Command="{Binding PlaylistVM.ToggleShuffleCommand}" FontSize="11" Margin="4,0">
                                <TextBlock Text="{Binding PlaylistVM.ShuffleLabel}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Button>
                            <Button Style="{StaticResource TextBtn}" Command="{Binding PlaylistVM.ToggleRepeatCommand}" FontSize="11" Margin="4,0">
                                <TextBlock Text="{Binding PlaylistVM.RepeatLabel}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Button>
                            <Button Style="{StaticResource TextBtn}" Command="{Binding SavePlaylistCommand}" FontSize="11" Margin="4,0">
                                <TextBlock Text="Save M3U" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Button>
                            <Button Style="{StaticResource TextBtn}" Command="{Binding LoadPlaylistCommand}" FontSize="11" Margin="4,0">
                                <TextBlock Text="Load M3U" Foreground="{StaticResource AccentLightBrush}"/>
                            </Button>
                        </WrapPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Compact Control Bar -->
        <Border x:Name="ControlsBar" Grid.Row="2" Background="{StaticResource BgPanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" VerticalAlignment="Bottom" Padding="15,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Seek Slider -->
                    <RowDefinition Height="Auto"/> <!-- Main Controls -->
                </Grid.RowDefinitions>

                <!-- Seek Slider -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Slider x:Name="SeekSlider" Style="{StaticResource SeekSlider}" IsMoveToPointEnabled="True" Maximum="1" Value="{Binding Position, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Cursor="Hand"
                            PreviewMouseLeftButtonDown="SeekBar_PreviewMouseDown"
                            PreviewMouseLeftButtonUp="SeekBar_PreviewMouseUp"
                            MouseMove="SeekSlider_MouseMove"
                            MouseLeave="SeekSlider_MouseLeave"/>
                    <!-- A-B loop position markers -->
                    <Canvas x:Name="AbMarkersCanvas" IsHitTestVisible="False" SizeChanged="AbMarkersCanvas_SizeChanged">
                        <Rectangle x:Name="AbMarkerA" Width="2" Height="14" Fill="#FF4CAF50" Visibility="Collapsed"/>
                        <Rectangle x:Name="AbMarkerB" Width="2" Height="14" Fill="#FFFF5722" Visibility="Collapsed"/>
                    </Canvas>
                    <!-- Hover time popup -->
                    <Popup x:Name="SeekHoverPopup" Placement="Mouse" AllowsTransparency="True"
                           IsHitTestVisible="False" StaysOpen="True" IsOpen="False">
                        <Border Background="#CC000000" CornerRadius="4" Padding="6,3">
                            <TextBlock x:Name="SeekHoverText" Foreground="White" FontSize="11" FontFamily="Segoe UI"/>
                        </Border>
                    </Popup>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>   <!-- Playback & Time -->
                        <ColumnDefinition Width="Auto"/> <!-- Center Title -->
                        <ColumnDefinition Width="*"/>   <!-- Volume & Settings -->
                    </Grid.ColumnDefinitions>

                    <!-- Left: Playback & Time -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconBtn}" ToolTip="{DynamicResource str_Previous}" Command="{Binding PrevTrackCommand}" Margin="0,0,12,0">
                            <iconPacks:PackIconMaterial Kind="SkipPrevious" Width="20" Height="20"/>
                        </Button>
                        <Button Style="{StaticResource PlayBtn}" ToolTip="{DynamicResource str_Play}" Command="{Binding PlayPauseCommand}" Width="42" Height="42" Margin="0,0,12,0">
                            <iconPacks:PackIconMaterial Kind="{Binding PlayPauseIcon}" Width="24" Height="24"/>
                        </Button>
                        <Button Style="{StaticResource IconBtn}" ToolTip="{DynamicResource str_Next}" Command="{Binding NextTrackCommand}" Margin="0,0,12,0">
                            <iconPacks:PackIconMaterial Kind="SkipNext" Width="20" Height="20"/>
                        </Button>
                        <Button Style="{StaticResource IconBtn}" ToolTip="{DynamicResource str_Stop}" Command="{Binding StopCommand}" Margin="0,0,12,0">
                            <iconPacks:PackIconMaterial Kind="Stop" Width="20" Height="20"/>
                        </Button>
                        <Button Style="{StaticResource IconBtn}" ToolTip="Previous Frame (,)" Command="{Binding FrameBackCommand}" Margin="0,0,4,0"
                                Visibility="{Binding IsNotPlaying, Converter={StaticResource BoolToVisConverter}}">
                            <iconPacks:PackIconMaterial Kind="SkipBackward" Width="16" Height="16"/>
                        </Button>
                        <Button Style="{StaticResource IconBtn}" ToolTip="Next Frame (.)" Command="{Binding NextFrameCommand}" Margin="0,0,12,0"
                                Visibility="{Binding IsNotPlaying, Converter={StaticResource BoolToVisConverter}}">
                            <iconPacks:PackIconMaterial Kind="SkipForward" Width="16" Height="16"/>
                        </Button>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="{Binding CurrentTimeStr}" FontWeight="Medium"/>
                            <TextBlock Text=" / " Foreground="{StaticResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding TotalTimeStr}" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Center: Title -->
                    <TextBlock Grid.Column="1" Text="{Binding CurrentTitle}" VerticalAlignment="Center" FontWeight="SemiBold" 
                               FontSize="14" MaxWidth="300" TextTrimming="CharacterEllipsis" 
                               HorizontalAlignment="Center" Visibility="{Binding ActualWidth, ElementName=ControlsBar, Converter={StaticResource WidthToVisibilityConverter}, ConverterParameter=800}"/>

                    <!-- Right: Volume & Options -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconBtn}" ToolTip="{DynamicResource str_Mute}" Command="{Binding ToggleMuteCommand}" Margin="0,0,8,0">
                            <iconPacks:PackIconMaterial Kind="{Binding MuteIcon}" Width="20" Height="20"/>
                        </Button>
                        <Slider Style="{StaticResource VolumeSlider}" Width="100" Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,15,0" Maximum="100"/>

                        <TextBlock Text="HW" Foreground="{StaticResource AccentLightBrush}" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold" FontSize="11"
                                   Visibility="{Binding EnableHardwareAcceleration, Converter={StaticResource BoolToVisConverter}}"/>
                        <Button Style="{StaticResource IconBtn}" ToolTip="{DynamicResource str_LoadSub}" Command="{Binding OpenSubtitleCommand}" Margin="0,0,8,0">
                            <iconPacks:PackIconMaterial Kind="Subtitles" Width="20" Height="20"/>
                        </Button>

                        <!-- Speed ComboBox (Phase 9.1) — index maps to SpeedValues array in VM -->
                        <ComboBox Style="{StaticResource DarkCombo}" Width="56" FontSize="11"
                                  SelectedIndex="{Binding SpeedIndex, Mode=TwoWay}"
                                  ToolTip="Playback speed (] faster  [ slower  \ reset)"
                                  Margin="0,0,8,0" VerticalAlignment="Center">
                            <ComboBoxItem Content="¼×"/>
                            <ComboBoxItem Content="½×"/>
                            <ComboBoxItem Content="¾×"/>
                            <ComboBoxItem Content="1×"/>
                            <ComboBoxItem Content="1¼×"/>
                            <ComboBoxItem Content="1½×"/>
                            <ComboBoxItem Content="2×"/>
                            <ComboBoxItem Content="4×"/>
                        </ComboBox>

                        <!-- Audio track ComboBox — only when ≥2 tracks (Phase 11.1) -->
                        <ComboBox Style="{StaticResource DarkCombo}" Width="76" FontSize="11"
                                  ItemsSource="{Binding AudioTracks}"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding CurrentAudioTrack, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  ToolTip="Audio track"
                                  Margin="0,0,8,0" VerticalAlignment="Center"
                                  Visibility="{Binding HasMultipleAudioTracks, Converter={StaticResource BoolToVisConverter}}"/>

                        <!-- Subtitle track ComboBox — includes "Off" entry (Phase 10.2) -->
                        <ComboBox Style="{StaticResource DarkCombo}" Width="76" FontSize="11"
                                  ItemsSource="{Binding SubtitleTracksWithOff}"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding CurrentSubtitleTrack, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  ToolTip="Subtitle track"
                                  Margin="0,0,8,0" VerticalAlignment="Center"/>

                        <Button Style="{StaticResource IconBtn}" x:Name="BtnSettingsCompact" Click="MenuSettings_Click" ToolTip="{DynamicResource str_Settings}" Margin="0,0,12,0">
                            <iconPacks:PackIconMaterial Kind="Cog" Width="20" Height="20"/>
                        </Button>

                        <Border Width="1" Height="20" Background="{StaticResource BorderBrush}" Margin="4,0,16,0"/>

                        <Button Style="{StaticResource IconBtn}" Command="{Binding TogglePlaylistCommand}" ToolTip="{DynamicResource str_Playlist}" Margin="0,0,12,0">
                            <iconPacks:PackIconMaterial Kind="PlaylistPlay" Width="20" Height="20"/>
                        </Button>
                        <Button Style="{StaticResource IconBtn}" Click="BtnPip_Click" ToolTip="Picture in Picture" Margin="0,0,12,0">
                            <iconPacks:PackIconMaterial Kind="PictureInPictureBottomRight" Width="20" Height="20"/>
                        </Button>
                        <Button Style="{StaticResource IconBtn}" Command="{Binding ToggleFullscreenCommand}" ToolTip="{DynamicResource str_Fullscreen}">
                            <iconPacks:PackIconMaterial Kind="Fullscreen" Width="20" Height="20"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- PiP Overlay (Popup so it stays above the video host) -->
        <Popup x:Name="PipPopup" IsOpen="False" AllowsTransparency="True" Placement="Center" PlacementTarget="{Binding ElementName=VideoArea}" StaysOpen="True">
            <Grid Width="{Binding ActualWidth, ElementName=VideoArea}" Height="{Binding ActualHeight, ElementName=VideoArea}" Background="#01000000"
                  MouseEnter="PipPopup_MouseEnter"
                  MouseMove="PipPopup_MouseMove"
                  MouseLeave="PipPopup_MouseLeave"
                  PreviewMouseLeftButtonDown="PipPopup_MouseLeftButtonDown">

                <!-- Drag handle — top-center, hidden when idle -->
                <Border x:Name="PipHoverHandle" Height="20" Width="84" CornerRadius="10"
                        VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,0"
                        Visibility="Collapsed"
                        Background="#66000000" BorderBrush="#44FFFFFF" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#99000000"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="⠿ drag" Foreground="White" FontSize="10"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Close button — top-right, hidden when idle -->
                <Button x:Name="PipCloseButton"
                        Style="{StaticResource IconBtn}"
                        Click="BtnClose_Click"
                        Foreground="{StaticResource DangerBrush}"
                        ToolTip="Close Player"
                        VerticalAlignment="Top" HorizontalAlignment="Right"
                        Width="28" Height="28" Margin="0,6,6,0"
                        Visibility="Collapsed">
                    <iconPacks:PackIconMaterial Kind="WindowClose" Width="12" Height="12"/>
                </Button>

                <!-- Play controls — bottom-center, hidden when idle -->
                <Border x:Name="PipOverlay" Background="{StaticResource TrayBgBrush}" CornerRadius="12" Padding="10"
                        VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,16"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconBtn}" Command="{Binding PrevTrackCommand}" Margin="4,0">
                            <iconPacks:PackIconMaterial Kind="SkipPrevious" Width="14" Height="14"/>
                        </Button>
                        <Button Style="{StaticResource PlayBtn}" Command="{Binding PlayPauseCommand}" Width="40" Height="40" Margin="4,0">
                            <iconPacks:PackIconMaterial Kind="{Binding PlayPauseIcon}" Width="20" Height="20"/>
                        </Button>
                        <Button Style="{StaticResource IconBtn}" Command="{Binding NextTrackCommand}" Margin="4,0">
                            <iconPacks:PackIconMaterial Kind="SkipNext" Width="14" Height="14"/>
                        </Button>
                        <Button Style="{StaticResource IconBtn}" Click="BtnPip_Click" ToolTip="Restore Window" Margin="10,0,0,0">
                            <iconPacks:PackIconMaterial Kind="FullscreenExit" Width="14" Height="14"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Popup>

    </Grid>
</Window>
