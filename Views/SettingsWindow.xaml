<Window x:Class="DarshanPlayer.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="480" SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>

        <!-- ── Tab Control (underline style) ───────────────── -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1"
                                    Background="Transparent">
                                <TabPanel IsItemsHost="True" Background="Transparent"/>
                            </Border>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Background="Transparent"
                                BorderThickness="0,0,0,2"
                                BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Buttons ──────────────────────────────────────── -->
        <Style TargetType="Button" BasedOn="{StaticResource TextBtn}"/>

        <!-- ── CheckBox ─────────────────────────────────────── -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- ── TextBlock ─────────────────────────────────────── -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ── Label ────────────────────────────────────────── -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- ── ListView (shortcuts table) ───────────────────── -->
        <Style TargetType="ListView">
            <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <GridViewRowPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource BgHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{StaticResource BgPanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

    </Window.Resources>

    <!-- Outer border provides the dark window chrome -->
    <Border Background="{StaticResource BgDeepBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" Opacity="0.5" ShadowDepth="4"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Padding="20,14,16,14"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="10,10,0,0"
                    Background="{StaticResource BgPanelBrush}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <DockPanel>
                    <TextBlock Text="Settings" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource IconBtn}"
                            Width="28" Height="28"
                            Click="CloseBtn_Click"
                            Foreground="{StaticResource DangerBrush}"
                            ToolTip="Close">
                        <Path Data="M0,0 L10,10 M10,0 L0,10"
                              Stroke="{StaticResource TextSecondaryBrush}"
                              StrokeThickness="1.5"
                              Width="10" Height="10"
                              Stretch="None"/>
                    </Button>
                </DockPanel>
            </Border>

            <!-- Tab content -->
            <TabControl Grid.Row="1" Margin="0">

                <!-- ── General ───────────────────────────────── -->
                <TabItem Header="General" Padding="16,10">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="500">
                        <StackPanel Margin="24,18,24,8">

                            <!-- Language -->
                            <TextBlock Text="Language" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <ComboBox Style="{StaticResource DarkCombo}"
                                      ItemsSource="{Binding Languages}"
                                      SelectedItem="{Binding SelectedLanguage}"
                                      DisplayMemberPath="DisplayName"
                                      Margin="0,0,0,16"/>

                            <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,14"/>

                            <!-- Startup -->
                            <TextBlock Text="Startup" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <CheckBox Content="Start maximized"
                                      IsChecked="{Binding StartMaximized, Mode=TwoWay}"/>

                            <Separator Background="{StaticResource BorderBrush}" Margin="0,10,0,14"/>

                            <!-- Windows integration -->
                            <TextBlock Text="Windows integration" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Button Content="Set as default player..." HorizontalAlignment="Left" Padding="14,6"
                                    Command="{Binding SetAsDefaultPlayerCommand}"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,6,0,10" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="Opens Windows Default apps. Windows asks you to confirm the choice there, so nothing changes until you pick Darshan Player for your file types."/>
                            <CheckBox Content="Open files in the already-running window"
                                      IsChecked="{Binding SingleInstance, Mode=TwoWay}"/>

                            <Separator Background="{StaticResource BorderBrush}" Margin="0,10,0,14"/>

                            <!-- Window -->
                            <TextBlock Text="Window" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <CheckBox Content="Always on top"
                                      IsChecked="{Binding AlwaysOnTop, Mode=TwoWay}"/>

                            <Separator Background="{StaticResource BorderBrush}" Margin="0,10,0,14"/>

                            <!-- Playback -->
                            <TextBlock Text="Playback" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <CheckBox Content="Enable hardware acceleration"
                                      IsChecked="{Binding EnableHardwareAcceleration, Mode=TwoWay}"/>
                            <TextBlock Text="Takes effect on the next opened file."
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11" Margin="0,2,0,0"/>

                            <Separator Background="{StaticResource BorderBrush}" Margin="0,12,0,14"/>

                            <!-- Frame step -->
                            <TextBlock Text="Frame step" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="44"/>
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0" Style="{StaticResource VolumeSlider}"
                                        Minimum="1" Maximum="60" IsSnapToTickEnabled="True" TickFrequency="1"
                                        VerticalAlignment="Center"
                                        Value="{Binding FrameStepCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Column="1" Text="{Binding FrameStepCount}" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" FontSize="12"/>
                            </Grid>
                            <TextBlock Text="Frames the , and . keys jump (when paused)."
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="11" Margin="0,2,0,0"/>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ── Keyboard Shortcuts ─────────────────────── -->
                <TabItem Header="Keyboard Shortcuts" Padding="16,10">
                    <Grid Margin="24,18,24,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Default keyboard shortcuts (read-only)"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11" Margin="0,0,0,10"/>

                        <ListView x:Name="ShortcutList" Grid.Row="1"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.CanContentScroll="True"
                                  MaxHeight="380">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Key" Width="170"
                                                    DisplayMemberBinding="{Binding Key}"/>
                                    <GridViewColumn Header="Action" Width="250"
                                                    DisplayMemberBinding="{Binding Action}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </TabItem>

            </TabControl>

            <!-- Footer -->
            <Border Grid.Row="2"
                    Padding="20,10"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10"
                    Background="{StaticResource BgPanelBrush}">
                <Button Content="Close"
                        HorizontalAlignment="Right"
                        Padding="24,7"
                        Click="CloseBtn_Click"/>
            </Border>
        </Grid>
    </Border>
</Window>
